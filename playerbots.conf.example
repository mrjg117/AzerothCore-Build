# ============================================================
# playerbots.conf —— E5-2676v3 弱单核护栏（示例）
# ------------------------------------------------------------
# 运行时挂载到 /azerothcore/etc/playerbots.conf，不烤进镜像。
# 以下键名以 mod-playerbots 的 playerbots.conf.dist 为准；
# 若你的模块版本键名有出入，请对照实际 .dist 校正。
# ============================================================

# 随机机器人数量（弱 U 建议 ≤ 40，避免峰值崩服）
PlayerbotMgr.MaxRandomBots = 40
PlayerbotMgr.MinRandomBots = 5

# 关闭自动加入战场（减少跨地图 CPU 抖动）
PlayerbotAI.RandomBotAutoJoinBG = 0

# 启动即登录随机机器人
PlayerbotAI.RandomBotAutologin = 1

# 世界服主配置 worldserver.conf 里另需设：
#   MapUpdate.Threads = 6        # 弱 U 限制线程数，勿拉满
#   PlayerbotAI.Enabled = 1
