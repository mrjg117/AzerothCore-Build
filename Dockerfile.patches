# ============================================================
# 补丁数据镜像（wotlk-patches）—— 与服务器镜像**分体构建**
# ------------------------------------------------------------
# ・把 3 个服务端模组的「客户端 AddOn」打包成镜像，供注册页下载
#   （玩家下载后放入 WoW 客户端 Interface/AddOns/）。
# ・核实结论（2026-08-08）：Nevaden/mod-item-affixes、
#   Old-Man-Warcraft/mod-guild-levels、TopHatMan/mod-bot-inventory-master
#   三个仓库均只含客户端 AddOn，未提供 DBC/MPQ 现成文件。
#   因此 dbc/ 与 mpq/ 暂为空，若你后续提供文件，重建本镜像即可。
# ============================================================

FROM alpine:3.20 AS fetch
RUN apk add --no-cache git
WORKDIR /src

# mod-item-affixes -> addon/ItemAffixes
RUN git clone --depth 1 https://github.com/Nevaden/mod-item-affixes.git mia \
 && mkdir -p /out/addons/ItemAffixes \
 && cp -r /src/mia/addon/ItemAffixes/. /out/addons/ItemAffixes/

# mod-guild-levels -> client_addon/GuildLevels
RUN git clone --depth 1 https://github.com/Old-Man-Warcraft/mod-guild-levels.git gl \
 && mkdir -p /out/addons/GuildLevels \
 && cp -r /src/gl/client_addon/GuildLevels/. /out/addons/GuildLevels/

# mod-bot-inventory-master -> BotInventoryMasterUI
RUN git clone --depth 1 https://github.com/TopHatMan/mod-bot-inventory-master.git bim \
 && mkdir -p /out/addons/BotInventoryMasterUI \
 && cp -r /src/bim/BotInventoryMasterUI/. /out/addons/BotInventoryMasterUI/

FROM busybox:1.36
WORKDIR /patches
COPY --from=fetch /out/addons /patches/addons
RUN mkdir -p /patches/dbc /patches/mpq
COPY patches-readme.md /patches/README.md
VOLUME ["/patches"]
