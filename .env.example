# 腾讯云容器镜像服务配置
TCR_NAMESPACE=your-namespace

# MySQL root 密码
MYSQL_ROOT_PASSWORD=your-password-here

# 地图数据（可选，按优先级自动选择）
# 1. 本地挂载：把地图数据放到 ./data 目录
# 2. 网盘地址：填 OneDrive/网盘直链（aria2c 多线程下载）
CLIENT_DATA_URL=https://dr.zhbq.eu.org/api/raw?path=/client-data.7z
# 3. 地图镜像：填腾讯云 TCR 镜像地址（docker pull 多线程）
DATA_IMAGE=
# 4. 都没有则从 GitHub 下载
# 填 "none" 跳过地图数据下载

# 服务器配置（可选）
SERVER_ADDRESS=127.0.0.1
SERVER_NAME=My AzerothCore Server

# Playerbots 配置（可选）
PLAYERBOT_MIN_BOTS=10
PLAYERBOT_MAX_BOTS=50
