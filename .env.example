# ===== 镜像 =====
# 与 GitHub Release 的 deploy-<VERSION> tag 一致（部署包内 VERSION 文件同值）
IMAGE_TAG=20260810-abcdef0
# 腾讯云 TCR 命名空间（DockerHub 同步推送，用户名在 Secrets 里）
TCR_NS=mrjg117

# ===== 注册页 ac-web =====
AC_WEB_PORT=8080
# 与下方 worldserver.conf 的 SOAP.Login / SOAP.Password 对应
SOAP_LOGIN=webreg
SOAP_PASSWORD=changeMeNow123!
# 玩家客户端填写的对外 realm 地址（deploy 时改 SQL，见 docs/DEPLOY.md）
REALM_ADDRESS=play.example.com

# ===== 数据库（官方 env.ac 引用，部署前请同步修改包内 conf/dist/env.ac）=====
MYSQL_ROOT_PASSWORD=changeDbRootPass
MYSQL_DATABASE=acore_auth
MYSQL_USER=acore
MYSQL_PASSWORD=changeDbUserPass
