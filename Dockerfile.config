# ============================================================
# 配置镜像（wotlk-config）—— 与服务器镜像**分体构建**
# ------------------------------------------------------------
# ・把默认配置（worldserver/authserver/playerbots）打包成镜像，
#   部署时由 deploy.sh 从本镜像导出到本地 ./config 再挂载。
# ・配置源文件在仓库 config-src/（纳入版本库）；本镜像 COPY 它。
# ・worldserver.conf / authserver.conf 为「部分覆盖」：只写必须
#   改的键（DB 指向 compose 的 db 服务、playerbots 护栏等），
#   其余键由 AC 内置默认值补齐，因此可直接整体覆盖 etc。
# ・playerbots.conf 含 E5 弱 U 护栏，可按需调整。
# ============================================================

FROM scratch
COPY config-src/ /azerothcore/etc/
