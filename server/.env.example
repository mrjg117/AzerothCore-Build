# AzerothCore-OK 服务端部署变量（deploy.sh 会复制为 .env）
# 改完后再跑 docker compose up -d

# 数据库 root 密码（官方 compose 读取；务必改成强密码）
DOCKER_DB_ROOT_PASSWORD=change_this_db_password

# 对外地址：玩家连接 / 客户端 realmlist.wtf 填这个（你的公网域名或 IP）
REALM_ADDRESS=play.example.com

# 镜像命名空间（腾讯云 TCR，默认 acok；换别的仓库改这里）
TCR_NS=ccr.ccs.tencentyun.com/acok

# 注册 SOAP 账号（需与 Cloudflare Worker 的 SOAP_LOGIN / SOAP_PASSWORD 一致）
SOAP_LOGIN=webreg
SOAP_PASSWORD=change_this_soap_password
