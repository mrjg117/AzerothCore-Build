# ============================================================
# 配置镜像（wotlk-config）—— 与服务器镜像**分体构建**
# ------------------------------------------------------------
# ・把默认配置打包成镜像，部署时由 deploy.sh 从本镜像导出到本地
#   ./runtime/config 再挂载到 /azerothcore/etc。
# ・配置源在仓库 config/（纳入版本库），**按模组分层**：
#     config/core/                 核心配置（worldserver / authserver）
#     config/modules/<模组>/*.conf 各模组配置（一模组一目录）
# ・AzerothCore 运行时读的是扁平的 /azerothcore/etc/，所以这里用一个
#   busybox 组装阶段把分层的源码树**扁平合并**，产物与分层前逐字节等价。
# ・同名 conf 冲突 → 构建直接失败，避免模组之间静默互相覆盖。
# ・详见 config/README.md（含命名约定与「文档-实际不一致」的判定基准）。
# ============================================================

FROM busybox:1.36 AS assemble

# 核心配置直接铺底
COPY config/core/ /out/

# 模组配置递归收集后平铺，重名即失败
COPY config/modules/ /src-modules/
RUN set -eu; \
    for f in $(find /src-modules -type f -name '*.conf' | sort); do \
        b=$(basename "$f"); \
        if [ -e "/out/$b" ]; then \
            echo "ERROR: 配置文件名冲突 -> $b （来自 $f）" >&2; \
            echo "       同名 conf 会互相覆盖，请重命名后重试。" >&2; \
            exit 1; \
        fi; \
        cp "$f" "/out/$b"; \
    done; \
    echo "== 合并进 /azerothcore/etc 的配置 =="; ls -1 /out

FROM scratch
COPY --from=assemble /out/ /azerothcore/etc/
