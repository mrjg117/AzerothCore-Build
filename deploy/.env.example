# ===== 镜像 =====
# 填 CI 构建出的镜像 tag（build-core.yml 的 VERSION），或直接用 latest（CI 也推 :latest）
IMAGE_TAG=latest
# 腾讯云 TCR 命名空间（DockerHub 同步推送，用户名在 Secrets 里）
TCR_NS=mrjg117

# ===== 数据库（官方 docker-compose.yml 通过 .env 读取，不在 env.ac 里）=====
# ac-database 的 MYSQL_ROOT_PASSWORD 取此变量；缺省回退 password（务必修改！）
DOCKER_DB_ROOT_PASSWORD=changeDbRootPass
# 数据库对外暴露端口（仅本机/内网管理用，无需公网可保持 3306）
DOCKER_DB_EXTERNAL_PORT=3306

# ===== 注册（worldserver SOAP，供外部注册服务调用）=====
# 与 worldserver SOAP.Login / SOAP.Password 对应
SOAP_LOGIN=webreg
SOAP_PASSWORD=changeMeNow123!
# 玩家客户端填写的对外 realm 地址（部署后改 SQL，见 deploy/README.md）
REALM_ADDRESS=play.example.com
